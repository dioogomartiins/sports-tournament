{
  "rules": {
    "torneio_state": {
      ".read": true,
      "logRef": {
        ".write": "auth != null && (root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' || root.child('utilizadores').child(auth.uid).child('role').val() === 'user') && newData.exists()",
        ".validate": "newData.isString() && newData.parent().parent().child('torneio_log').child(newData.val()).child('uid').val() === auth.uid && !root.child('torneio_log').child(newData.val()).exists()"
      },
      "results": {
        ".write": "auth != null && root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' && newData.parent().child('logRef').val() !== root.child('torneio_state').child('logRef').val()",
        "$jogo": {
          ".write": "auth != null && (root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' || root.child('utilizadores').child(auth.uid).child('role').val() === 'user') && newData.parent().parent().child('logRef').val() !== root.child('torneio_state').child('logRef').val()",
          ".validate": "$jogo.matches(/^[0-9]{1,4}$/) && ((newData.isString() && newData.val().matches(/^[0-9]{1,3}-[0-9]{1,3}$/)) || newData.hasChild('score'))",
          "score": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}-[0-9]{1,3}$/)"
          },
          "penalties": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}-[0-9]{1,3}$/)"
          },
          "status": {
            ".validate": "newData.val() === 'agendado' || newData.val() === 'decorrer' || newData.val() === 'terminado'"
          },
          "mvp": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "scorers": {
            "$lado": {
              ".validate": "$lado === 'home' || $lado === 'away'",
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && (newData.isNumber() || (newData.isString() && newData.val().length <= 100))"
              }
            }
          },
          "assists": {
            "$lado": {
              ".validate": "$lado === 'home' || $lado === 'away'",
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && (newData.isNumber() || (newData.isString() && newData.val().length <= 100))"
              }
            }
          },
          "$outro": {
            ".validate": false
          }
        }
      },
      "schedule": {
        ".write": "auth != null && root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' && newData.parent().child('logRef').val() !== root.child('torneio_state').child('logRef').val()",
        "$i": {
          "home": {
            ".write": "auth != null && (root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' || root.child('utilizadores').child(auth.uid).child('role').val() === 'user') && newData.parent().parent().parent().child('logRef').val() !== root.child('torneio_state').child('logRef').val()",
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 100)"
          },
          "away": {
            ".write": "auth != null && (root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' || root.child('utilizadores').child(auth.uid).child('role').val() === 'user') && newData.parent().parent().parent().child('logRef').val() !== root.child('torneio_state').child('logRef').val()",
            ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 100)"
          }
        }
      },
      "jogosSingulares": {
        ".write": "auth != null && (root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' || root.child('utilizadores').child(auth.uid).child('role').val() === 'user') && newData.parent().child('logRef').val() !== root.child('torneio_state').child('logRef').val()"
      },
      "exportedAt": {
        ".write": "auth != null && (root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' || root.child('utilizadores').child(auth.uid).child('role').val() === 'user')",
        ".validate": "newData.isString() && newData.val().length <= 40"
      },
      "version": {
        ".write": "auth != null && (root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' || root.child('utilizadores').child(auth.uid).child('role').val() === 'user')",
        ".validate": "newData.isNumber()"
      },
      "$secao": {
        ".write": "auth != null && root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' && newData.parent().child('logRef').val() !== root.child('torneio_state').child('logRef').val()"
      }
    },
    "utilizadores": {
      ".read": "auth != null && root.child('utilizadores').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "nome": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "email": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "foto": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "ultimoAcesso": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now"
        },
        "role": {
          ".write": "auth != null && root.child('utilizadores').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.val() === 'admin' || newData.val() === 'user'"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "torneio_log": {
      ".read": "auth != null && root.child('utilizadores').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": [
        "quando"
      ],
      "$entrada": {
        ".write": "auth != null && !data.exists() && (root.child('utilizadores').child(auth.uid).child('role').val() === 'admin' || root.child('utilizadores').child(auth.uid).child('role').val() === 'user')",
        ".validate": "newData.hasChildren(['uid', 'nome', 'acao', 'quando']) && newData.child('uid').val() === auth.uid && newData.child('quando').val() === now",
        "uid": {
          ".validate": "newData.isString()"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "acao": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "quando": {
          ".validate": "newData.isNumber()"
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}
