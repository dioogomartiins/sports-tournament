{
  "rules": {
    "torneio_state": {
      ".read": true,
      ".write": false
    },
    "torneio_log": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'master'",
      ".write": false
    },
    "arquivo": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'master'",
      "$entryId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (!data.exists() && newData.child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.child('sport').val()).val() === true) || (data.exists() && data.child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(data.child('sport').val()).val() === true && (!newData.exists() || newData.child('sport').val() === data.child('sport').val())) || (data.exists() && !data.child('sport').exists() && root.child('users').child(auth.uid).child('admin').child('football').val() === true && (!newData.exists() || !newData.child('sport').exists() || newData.child('sport').val() === 'football')))",
        ".validate": "newData.child('id').val() === $entryId"
      }
    },
    "players": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'master'",
      "$playerId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).hasChild('admin')) && !data.exists() && newData.exists()))",
        ".validate": "newData.child('id').val() === $playerId",
        "id": {
          ".validate": "newData.isString()"
        },
        "nome": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).hasChild('admin')))",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "teamIdx": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).hasChild('admin')))",
          ".validate": "newData.isNumber()"
        },
        "ratings": {
          "$sport": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || root.child('users').child(auth.uid).child('admin').child($sport).val() === true)"
          }
        },
        "atributos": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || root.child('users').child(auth.uid).child('admin').child('football').val() === true)"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "singleMatches": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || root.child('users').child(auth.uid).child('admin').child('football').val() === true)",
      "$matchId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || root.child('users').child(auth.uid).child('admin').child('football').val() === true)",
        ".validate": "newData.child('id').val() === $matchId"
      }
    },
    "tournaments": {
      ".read": true,
      "$tournamentId": {
        ".read": true,
        "logRef": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).hasChild('admin') || root.child('users').child(auth.uid).child('role').val() === 'user') && newData.exists()",
          ".validate": "newData.isString() && newData.parent().parent().parent().child('tournament_log').child($tournamentId).child(newData.val()).child('uid').val() === auth.uid && !root.child('tournament_log').child($tournamentId).child(newData.val()).exists()"
        },
        "meta": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true)) && newData.parent().child('logRef').val() !== root.child('tournaments').child($tournamentId).child('logRef').val()",
          "sport": {
            ".validate": "newData.isString() && newData.val().length <= 50 && (!data.exists() || data.val() === newData.val())"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "status": {
            ".validate": "newData.val() === 'active' || newData.val() === 'finished'"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$outro": {
            ".validate": false
          }
        },
        "results": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true)) && newData.parent().child('logRef').val() !== root.child('tournaments').child($tournamentId).child('logRef').val()",
          "$jogo": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true)) && newData.parent().parent().child('logRef').val() !== root.child('tournaments').child($tournamentId).child('logRef').val()",
            ".validate": "$jogo.matches(/^[0-9]{1,4}$/) && ((newData.isString() && newData.val().matches(/^[0-9]{1,3}-[0-9]{1,3}$/)) || newData.hasChild('score'))",
            "score": {
              ".validate": "newData.isString() && (newData.val().matches(/^[0-9]{1,3}-[0-9]{1,3}$/) || ((newData.parent().parent().parent().child('meta').child('sport').val() === 'padel' || newData.parent().parent().parent().child('meta').child('sport').val() === 'tennis') && newData.val().matches(/^[0-9]{1,2}-[0-9]{1,2}( [0-9]{1,2}-[0-9]{1,2}){1,4}$/)))"
            },
            "penalties": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}-[0-9]{1,3}$/)"
            },
            "status": {
              ".validate": "newData.val() === 'agendado' || newData.val() === 'decorrer' || newData.val() === 'terminado'"
            },
            "mvp": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "scorers": {
              ".validate": "newData.parent().parent().parent().child('meta').child('sport').val() !== 'padel' && newData.parent().parent().parent().child('meta').child('sport').val() !== 'tennis'",
              "$lado": {
                ".validate": "$lado === 'home' || $lado === 'away'",
                "$i": {
                  ".validate": "$i.matches(/^[0-9]{1,2}$/) && (newData.isNumber() || (newData.isString() && newData.val().length <= 100))"
                }
              }
            },
            "assists": {
              ".validate": "newData.parent().parent().parent().child('meta').child('sport').val() !== 'padel' && newData.parent().parent().parent().child('meta').child('sport').val() !== 'tennis'",
              "$lado": {
                ".validate": "$lado === 'home' || $lado === 'away'",
                "$i": {
                  ".validate": "$i.matches(/^[0-9]{1,2}$/) && (newData.isNumber() || (newData.isString() && newData.val().length <= 100))"
                }
              }
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "schedule": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true)) && newData.parent().child('logRef').val() !== root.child('tournaments').child($tournamentId).child('logRef').val()",
          "$i": {
            "home": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().parent().parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().parent().parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true)) && newData.parent().parent().parent().child('logRef').val() !== root.child('tournaments').child($tournamentId).child('logRef').val()",
              ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 100)"
            },
            "away": {
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().parent().parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().parent().parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true)) && newData.parent().parent().parent().child('logRef').val() !== root.child('tournaments').child($tournamentId).child('logRef').val()",
              ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 100)"
            }
          }
        },
        "jogosSingulares": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true)) && newData.parent().child('logRef').val() !== root.child('tournaments').child($tournamentId).child('logRef').val()"
        },
        "exportedAt": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true) || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "version": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true) || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isNumber()"
        },
        "$secao": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (newData.parent().child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(newData.parent().child('meta').child('sport').val()).val() === true) || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true)) && newData.parent().child('logRef').val() !== root.child('tournaments').child($tournamentId).child('logRef').val()"
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'master'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'master')",
        "nome": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "email": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "foto": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "ultimoAcesso": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now"
        },
        "role": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'master'",
          ".validate": "newData.val() === 'master' || newData.val() === 'admin' || newData.val() === 'user'"
        },
        "admin": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'master'",
          "$sport": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "utilizadores": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || root.child('utilizadores').child(auth.uid).child('role').val() === 'admin')",
      ".write": false
    },
    "tournament_log": {
      "$tournamentId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'master' || (root.child('tournaments').child($tournamentId).child('meta').child('sport').exists() && root.child('users').child(auth.uid).child('admin').child(root.child('tournaments').child($tournamentId).child('meta').child('sport').val()).val() === true))",
        ".indexOn": [
          "quando"
        ],
        "$entrada": {
          ".write": "auth != null && !data.exists() && (root.child('users').child(auth.uid).child('role').val() === 'master' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).hasChild('admin') || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.hasChildren(['uid', 'nome', 'acao', 'quando']) && newData.child('uid').val() === auth.uid && newData.child('quando').val() === now",
          "uid": {
            ".validate": "newData.isString()"
          },
          "nome": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "acao": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "quando": {
            ".validate": "newData.isNumber()"
          },
          "$outro": {
            ".validate": false
          }
        }
      }
    }
  }
}
