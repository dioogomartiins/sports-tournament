{
  "output": {
    "filePath": "knowledge/repomix-context.md",
    "style": "markdown",
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 10,
    "showLineNumbers": false
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".github/",
      ".gemini/",
      ".claude/",
      "knowledge/",
      "package-lock.json"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
